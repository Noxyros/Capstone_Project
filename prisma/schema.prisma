datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum PowerUpType {
  STREAK_FREEZE
  HEART_REFILL
  DOUBLE_XP
}

enum RoadmapNodeType {
  LESSON
  QUIZ
}

enum RoadmapContentType {
  TEXT
  POSTER
  MATERIAL
}

model User {
  id                 String                 @id @default(uuid())
  supabaseAuthId     String?                @unique
  email              String                 @unique
  name               String?
  handle             String?                @unique
  avatarUrl          String?
  role               Role                   @default(STUDENT)
  streak             Int                    @default(0)
  totalXp            Int                    @default(0)
  gems               Int                    @default(500)
  hearts             Int                    @default(5)
  maxHearts          Int                    @default(5)
  superMode          Boolean                @default(false)
  doubleXpUntil      DateTime?
  lastActive         DateTime               @default(now())
  lastActivityDate   String?                @db.VarChar(10)
  powerUps           UserPowerUp[]
  progress           UserProgress[]
  questProgress      UserQuestProgress[]
  dailyQuizAttempts  UserDailyQuizAttempt[]
  createdAt          DateTime               @default(now())
  darkMode           Boolean                @default(false)
  soundEffects       Boolean                @default(true)
  dailyReminders     Boolean                @default(true)
  language           String                 @default("en")
  createdSubjects    Subject[]              @relation("SubjectCreator")
  subjectEnrollments SubjectEnrollment[]
  nodeProgress       NodeProgress[]
  rewardEvents       RewardEvent[]
  quizAttempts       QuizAttempt[]
  quizAnswers        QuizAnswer[]
  activityDays       ActivityDay[]
}

model PowerUp {
  id           String        @id @default(uuid())
  name         String // e.g., "Streak Freeze"
  code         PowerUpType   @unique
  description  String
  costGems     Int
  icon         String // e.g., "snowflake", "heart", "gem"
  userPowerUps UserPowerUp[]
}

model UserPowerUp {
  id        String  @id @default(uuid())
  userId    String
  powerUpId String
  quantity  Int     @default(0)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  powerUp   PowerUp @relation(fields: [powerUpId], references: [id], onDelete: Cascade)

  @@unique([userId, powerUpId])
}

model DailyQuest {
  id           String              @id @default(uuid())
  title        String // e.g., "Complete 1 Lesson"
  description  String
  targetCount  Int                 @default(1)
  xpReward     Int                 @default(25)
  userProgress UserQuestProgress[]
}

model UserQuestProgress {
  id           String     @id @default(uuid())
  userId       String
  questId      String
  currentCount Int        @default(0)
  completed    Boolean    @default(false)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest        DailyQuest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model DailyQuiz {
  id       String                 @id @default(uuid())
  date     String                 @unique // Format: "YYYY-MM-DD" for 1-a-day lock
  title    String                 @default("Are You Smarter Than a 7th Grader?")
  prompt   String
  xpReward Int                    @default(50)
  options  DailyQuizOption[]
  attempts UserDailyQuizAttempt[]
}

model DailyQuizOption {
  id          String    @id @default(uuid())
  text        String
  isCorrect   Boolean   @default(false)
  dailyQuizId String
  dailyQuiz   DailyQuiz @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)
}

model UserDailyQuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  dailyQuizId String
  passed      Boolean   @default(false)
  completedAt DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyQuiz   DailyQuiz @relation(fields: [dailyQuizId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyQuizId]) // Guarantees Wordle-style ONCE-PER-DAY limit per user
}

model Grade {
  id       String    @id @default(uuid())
  name     String // e.g., "Class 7"
  level    Int // e.g., 7
  subjects Subject[]
}

model Subject {
  id          String              @id @default(uuid())
  name        String
  icon        String?
  color       String              @default("blue")
  gradeId     String
  createdById String?
  grade       Grade               @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation("SubjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  chapters    Chapter[]
  enrollments SubjectEnrollment[]

  @@index([createdById])
}

model Chapter {
  id          String         @id @default(uuid())
  title       String
  order       Int            @default(1)
  summaryText String         @db.Text
  isPublished Boolean        @default(true)
  subjectId   String
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  nodes       RoadmapNode[]
  progress    UserProgress[]

  @@index([subjectId, order])
}

model RoadmapNode {
  id           String             @id
  title        String
  order        Int                @default(1)
  type         RoadmapNodeType
  contentType  RoadmapContentType @default(TEXT)
  content      String             @db.Text
  resourceUrl  String             @db.Text
  isPublished  Boolean            @default(true)
  chapterId    String
  chapter      Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions    Question[]
  progress     NodeProgress[]
  quizAttempts QuizAttempt[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([chapterId, order])
}

model Question {
  id          String       @id @default(uuid())
  prompt      String
  nodeId      String
  node        RoadmapNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  options     Option[]
  quizAnswers QuizAnswer[]

  @@index([nodeId])
}

model Option {
  id         String   @id @default(uuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id        String  @id @default(uuid())
  userId    String
  chapterId String
  completed Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model SubjectEnrollment {
  id         String   @id @default(uuid())
  studentId  String
  subjectId  String
  enrolledAt DateTime @default(now())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId])
  @@index([subjectId])
}

model NodeProgress {
  id          String      @id @default(uuid())
  userId      String
  nodeId      String
  completedAt DateTime?
  bestScore   Int?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  node        RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([nodeId])
}

model RewardEvent {
  id             String   @id @default(uuid())
  userId         String
  idempotencyKey String
  xpDelta        Int      @default(0)
  gemsDelta      Int      @default(0)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model QuizAttempt {
  id          String       @id @default(uuid())
  userId      String
  nodeId      String
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  node        RoadmapNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([userId, nodeId, startedAt])
}

model QuizAnswer {
  id                String      @id @default(uuid())
  userId            String
  attemptId         String
  questionId        String
  selectedOptionIds String[]
  isCorrect         Boolean
  heartLost         Boolean     @default(false)
  createdAt         DateTime    @default(now())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([userId, createdAt])
}

model ActivityDay {
  id        String   @id @default(uuid())
  userId    String
  date      String   @db.VarChar(10)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}
